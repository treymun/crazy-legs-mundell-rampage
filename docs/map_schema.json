{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treymun/crazy-legs-mundell-rampage/docs/map_schema.json",
  "title": "Crazy Legs Mundell Rampage map source (clmr-map version 1)",
  "description": "godot/maps/<id>.map.json. 1 map unit = 1 cell; x east, y south, z up; eye .95, door 1.85, step .245, body .2 round, 1.12 tall. From tools/map.gd -- schema.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "id",
    "objects"
  ],
  "properties": {
    "schema": {
      "const": "clmr-map"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "base": {
      "type": "object",
      "required": [
        "plan"
      ],
      "properties": {
        "plan": {
          "type": "string"
        }
      },
      "description": "build on tools/levels/<plan>_plan.gd; then size/districts come from it"
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 4,
        "maximum": 256
      },
      "minItems": 2,
      "maxItems": 2
    },
    "border": {
      "type": "string",
      "description": "the tile of the solid cells round everything"
    },
    "meta": {
      "type": "object",
      "description": "title, sky, score, ambience, intro, heading, layout (bump layout when the map changes: old saves start the chapter over)"
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tint": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "spawn": {
      "type": "object",
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "angle": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "playtest": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {},
              "to": {},
              "seconds": {
                "type": "number"
              }
            }
          }
        },
        "enemies": {
          "type": "boolean"
        },
        "perf": {
          "type": "boolean"
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "title": "yard",
            "description": "Open ground under the sky over whole cells.",
            "type": "object",
            "required": [
              "id",
              "type",
              "rect",
              "floor"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "type": {
                "const": "yard"
              },
              "rect": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "[x0, y0, x1, y1] map units, x1 y1 exclusive"
              },
              "floor": {
                "type": "string"
              },
              "district": {
                "type": "string"
              },
              "ground": {
                "type": "number"
              },
              "light": {
                "type": "number"
              }
            },
            "patternProperties": {
              "^_": {}
            },
            "additionalProperties": false
          },
          {
            "title": "room",
            "description": "Open floor under a roof `roof` high (cells); walls come from solid cells round it.",
