            "required": [
              "id",
              "type",
              "rect",
              "floor"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "type": {
                "const": "room"
              },
              "rect": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "[x0, y0, x1, y1] map units, x1 y1 exclusive"
              },
              "floor": {
                "type": "string"
              },
              "district": {
                "type": "string"
              },
              "roof": {
                "type": "number"
              },
              "ground": {
                "type": "number"
              },
              "light": {
                "type": "number"
              },
              "ceiling": {
                "type": "string"
              },
