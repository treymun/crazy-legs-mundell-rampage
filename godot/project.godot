; Crazy Legs Mundell Rampage - Godot 4 port
; Base canvas is 320x200 like the original; the window is scaled by main.gd.
config_version=5

[application]

config/name="Crazy Legs Mundell Rampage"
config/description="Port of the 320x200 software-rendered FPS."
config/version="3.13.0"
run/main_scene="res://src/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icons/icon.png"
; The 3D rewrite keeps its own profile (saves, settings, records) so a test
; build never touches the released game's.
config/use_custom_user_dir=true
config/custom_user_dir_name="Crazy Legs Mundell Rampage 3D"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.047058824, 0.03529412, 0.03137255, 1)
boot_splash/show_image=false

[audio]

; The mix pans every voice with a bus effect (pygame's set_volume(L, R)).
; Browsers default to sample playback, which skips bus effects, so the web
; build streams through the mixer like the desktop one.
general/default_playback_type.web=0
; Online voice chat reads the mic (src/net/voice_chat.gd): the device is only
; opened when MICROPHONE is turned on in a lobby (a phone and a browser ask
; then), never at start.
driver/enable_input=true

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="disabled"
window/stretch/aspect="ignore"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.047058824, 0.03529412, 0.03137255, 1)
anti_aliasing/quality/msaa_2d=0

[input_devices]

; Fingers and the mouse are read separately (src/touch_controls.gd): a touch
; that also arrived as a left click would fire the weapon on every tap.
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0,
"res://tools": 0
}
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[editor_plugins]

enabled=PackedStringArray("res://addons/clmr_levels/plugin.cfg", "res://addons/clmr_maps/plugin.cfg", "res://addons/clmr_updater/plugin.cfg")

[shader_globals]

; The 3D view's numbers of the frame (src/view3d/view_light.gdshaderinc,
; world_view.gd _share), set once a frame instead of on every material, and
; its textures (read with texelFetch).

anim_count={
"type": "int",
"value": 0
}
anim_time={
"type": "float",
"value": 0.0
}
blackout={
"type": "float",
"value": 0.0
}
