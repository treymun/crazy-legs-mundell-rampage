# gdlint settings for the port. Run from this folder:  gdlint src tools
#
# The big scripts are chains of layers (game_state.gd -> ... -> game.gd, the
# same for renderer.gd and main.gd), so a file stays under 1,500 lines: add
# a layer or move a group of functions down rather than raise the limit.
# Method counts, early returns and declaration order follow the Python
# original the port came from, so those checks are off.
disable:
- class-definitions-order
- max-returns
- max-public-methods
- function-arguments-number
max-file-lines: 1500
max-line-length: 100
# A trailing underscore marks a local copy of a member taken for a hot loop
# (out_, dep_) or a name that would shadow a built-in (TAU_, scale_).
constant-name: _?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*_?
function-variable-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*_?'
# Enemies_TELLS() / Enemies_BOSS_TITLES() stand in for the Python module tables.
function-name: (_on_([A-Z][a-z0-9]*)+(_[a-z0-9]+)*|_?[a-z][a-z0-9]*(_[a-z0-9]+)*|Enemies_[A-Z]+(_[A-Z]+)*)
excluded_directories: !!set
  .git: null
  .godot: null
  build: null
